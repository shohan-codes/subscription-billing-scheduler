{
    "name": "subscription-billing-scheduler",
    "version": "0.0.1",
    "description": "Reliability-focused subscription billing scheduler",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,yaml,yml,md}\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,test}/**/*.ts\" --fix",
        "lint:check": "eslint \"{src,test}/**/*.ts\"",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "check": "pnpm typecheck && pnpm lint:check && pnpm test && pnpm build",
        "typecheck": "tsc --noEmit",
        "db:migrate": "kysely migrate latest",
        "db:rollback": "kysely migrate rollback --all",
        "db:migration:create": "kysely migrate make"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.0.1",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/swagger": "^11.4.6",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cron": "^4.4.0",
        "helmet": "^8.3.0",
        "kysely": "^0.29.5",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.0.0",
        "@types/pg": "^8.21.0",
        "@types/supertest": "^7.0.0",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^17.0.0",
        "jest": "^30.0.0",
        "kysely-ctl": "^0.21.0",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "packageManager": "pnpm@11.22.0"
}
